/* Awake stylesheet template. Double-brace placeholders are filled by theme.py. */

QWidget {
    color: {{text}};
    font-size: 13px;
    selection-background-color: {{accent_soft}};
    selection-color: {{text}};
}

QWidget#Root, QStackedWidget#Pages, QWidget[page="true"], QScrollArea#PageScroll,
QScrollArea#PageScroll > QWidget > QWidget {
    background: {{bg}};
}

QScrollArea { border: none; background: transparent; }

/* ---------------------------------------------------------------- sidebar */

QFrame#Sidebar {
    background: {{sidebar}};
    border: none;
    border-right: 1px solid {{border}};
}

QLabel#BrandName { font-size: 15px; font-weight: 600; }
QLabel#SidebarVersion { color: {{text_muted}}; font-size: 11px; }
QLabel#SidebarStatus { color: {{text_secondary}}; font-size: 12px; }

QPushButton[nav="true"] {
    background: transparent;
    color: {{text_secondary}};
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
}
QPushButton[nav="true"]:hover { background: {{surface_hover}}; color: {{text}}; }
QPushButton[nav="true"]:checked {
    background: {{accent_soft}};
    color: {{text}};
    font-weight: 600;
}

/* ---------------------------------------------------------------- typography */

QLabel[role="title"] { font-size: 22px; font-weight: 600; }
QLabel[role="subtitle"] { color: {{text_secondary}}; font-size: 13px; }
QLabel[role="cardTitle"] { font-size: 14px; font-weight: 600; }
QLabel[role="section"] {
    color: {{text_muted}};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
}
QLabel[role="body"] { color: {{text_secondary}}; font-size: 13px; }
QLabel[role="caption"] { color: {{text_muted}}; font-size: 12px; }
QLabel[role="metaValue"] { color: {{text}}; font-size: 13px; font-weight: 500; }
QLabel[role="heroTitle"] { font-size: 20px; font-weight: 600; }
QLabel[role="bigValue"] { font-size: 30px; font-weight: 600; }
QLabel[role="bigValue"][muted="true"] { color: {{text_muted}}; }
QLabel[role="rowTitle"] { font-size: 13px; font-weight: 500; }
QLabel[role="rowDescription"] { color: {{text_muted}}; font-size: 12px; }
QLabel[role="link"] { color: {{accent}}; }

/* ---------------------------------------------------------------- cards */

QFrame[card="true"] {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: 14px;
}
QFrame[divider="true"] { background: {{border}}; border: none; max-height: 1px; min-height: 1px; }

QFrame[iconTile="true"] {
    background: {{surface_alt}};
    border: 1px solid {{border}};
    border-radius: 9px;
}
QFrame[iconTile="true"][active="true"] {
    background: {{accent_soft}};
    border: 1px solid {{accent_border}};
}

QFrame[rowHover="true"] { border-radius: 10px; background: transparent; }
QFrame[rowHover="true"]:hover { background: {{surface_hover}}; }

/* ---------------------------------------------------------------- pills & badges */

QFrame#StatusPill {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: 13px;
}
QFrame#StatusPill[active="true"] { background: {{success_soft}}; border: 1px solid {{success_soft}}; }
QFrame#StatusPill QLabel { font-size: 12px; font-weight: 500; color: {{text_secondary}}; }
QFrame#StatusPill[active="true"] QLabel { color: {{success}}; }

QLabel[badge="completed"], QLabel[badge="stopped"], QLabel[badge="interrupted"],
QLabel[badge="failed"], QLabel[badge="active"], QLabel[badge="neutral"] {
    border-radius: 8px;
    padding: 3px 9px;
    min-height: 14px;
    font-size: 11px;
    font-weight: 600;
}
QLabel[badge="completed"] { background: {{success_soft}}; color: {{success}}; }
QLabel[badge="active"] { background: {{accent_soft}}; color: {{accent}}; }
QLabel[badge="stopped"], QLabel[badge="neutral"] { background: {{surface_alt}}; color: {{text_secondary}}; }
QLabel[badge="interrupted"] { background: {{warning_soft}}; color: {{warning}}; }
QLabel[badge="failed"] { background: {{danger_soft}}; color: {{danger}}; }

/* ---------------------------------------------------------------- buttons */

QPushButton {
    background: {{surface_alt}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 10px;
    padding: 7px 14px;
    font-weight: 500;
}
QPushButton:hover { background: {{surface_hover}}; border-color: {{border_strong}}; }
QPushButton:pressed { background: {{surface}}; }
QPushButton:disabled { color: {{text_muted}}; }
QPushButton:focus { outline: none; }

QPushButton[variant="primary"] {
    background: {{accent}};
    color: {{accent_text}};
    border: 1px solid {{accent}};
}
QPushButton[variant="primary"]:hover { background: {{accent_hover}}; border-color: {{accent_hover}}; }
QPushButton[variant="primary"]:pressed { background: {{accent_pressed}}; }

QPushButton[variant="danger"] {
    background: transparent;
    color: {{danger}};
    border: 1px solid {{danger_soft}};
}
QPushButton[variant="danger"]:hover { background: {{danger_soft}}; }
QPushButton[variant="danger"]:disabled { color: {{text_muted}}; border-color: {{border}}; }

QPushButton[variant="link"] {
    background: transparent;
    border: none;
    color: {{accent}};
    padding: 4px 6px;
    font-weight: 500;
}
QPushButton[variant="link"]:hover { color: {{accent_hover}}; background: {{accent_soft}}; }

QPushButton[segment="true"] {
    background: {{surface_alt}};
    color: {{text_secondary}};
    border: 1px solid {{border}};
    border-radius: 10px;
    padding: 9px 4px;
    font-weight: 500;
    min-width: 72px;
}
QPushButton[segment="true"]:hover { color: {{text}}; border-color: {{border_strong}}; }
QPushButton[segment="true"]:checked {
    background: {{accent_soft}};
    color: {{text}};
    border: 1px solid {{accent_border}};
    font-weight: 600;
}

/* ---------------------------------------------------------------- inputs */

QComboBox {
    background: {{surface_alt}};
    border: 1px solid {{border}};
    border-radius: 9px;
    padding: 6px 30px 6px 12px;
    min-width: 132px;
    color: {{text}};
}
QComboBox:hover { border-color: {{border_strong}}; }
QComboBox::drop-down { border: none; width: 26px; subcontrol-position: center right; }
QComboBox::down-arrow { image: url("{{chevron_url}}"); width: 14px; height: 14px; }
QComboBox QAbstractItemView {
    background: {{surface}};
    border: 1px solid {{border_strong}};
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: {{accent_soft}};
}

/* ---------------------------------------------------------------- table */

QTableView {
    background: transparent;
    border: none;
    gridline-color: transparent;
    outline: none;
    alternate-background-color: transparent;
}
QTableView::item { padding: 0 12px; border-bottom: 1px solid {{border}}; }
QTableView::item:selected { background: {{accent_soft}}; color: {{text}}; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background: transparent;
    color: {{text_muted}};
    border: none;
    border-bottom: 1px solid {{border}};
    padding: 10px 12px;
    font-size: 11px;
    font-weight: 600;
}
QHeaderView::section:hover { color: {{text}}; }
QTableCornerButton::section { background: transparent; border: none; }

/* ---------------------------------------------------------------- scrollbars */

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: {{border_strong}}; border-radius: 3px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: {{text_muted}}; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: {{border_strong}}; border-radius: 3px; min-width: 32px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------------------------------------------------------------- menus, tooltips, dialogs */

QMenu {
    background: {{surface}};
    border: 1px solid {{border_strong}};
    border-radius: 10px;
    padding: 6px;
}
QMenu::item { padding: 6px 24px 6px 12px; border-radius: 6px; }
QMenu::item:selected { background: {{accent_soft}}; }
QMenu::item:disabled { color: {{text_muted}}; }
QMenu::separator { height: 1px; background: {{border}}; margin: 5px 6px; }

QToolTip {
    background: {{surface_alt}};
    color: {{text}};
    border: 1px solid {{border_strong}};
    border-radius: 6px;
    padding: 4px 8px;
}

QMessageBox, QDialog { background: {{surface}}; }
QMessageBox QLabel { color: {{text}}; }
